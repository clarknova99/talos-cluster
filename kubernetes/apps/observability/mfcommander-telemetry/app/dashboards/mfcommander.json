    {
      "id": 13,
      "type": "timeseries",
      "title": "Active licenses by tier",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mfcommander"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mfcommander"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT d AS time,\n       l.tier AS metric,\n       count(l.license_id) AS value\nFROM generate_series(date_trunc('day', $__timeFrom()::timestamptz),\n                     $__timeTo()::timestamptz,\n                     interval '1 day') AS d\nJOIN licenses l\n  ON l.issued_at < d + interval '1 day'\n AND (l.status = 'active' OR l.revoked_at >= d + interval '1 day')\nGROUP BY 1, 2\nORDER BY 1, 2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "short",
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Per day: licenses issued (issued_at) by then and either still active or revoked/refunded only later (revoked_at)."
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Licenses",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mfcommander"
      },
      "gridPos": {
        "x": 12,
        "y": 34,
        "w": 6,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mfcommander"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FILTER (WHERE status = 'active') AS \"Active now\",\n       count(*) FILTER (WHERE $__timeFilter(issued_at)) AS \"Issued in range\",\n       count(*) FILTER (WHERE $__timeFilter(revoked_at)) AS \"Revoked in range\"\nFROM licenses"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "description": "Active now ignores the time range; issued and revoked use issued_at / revoked_at within it."
    },

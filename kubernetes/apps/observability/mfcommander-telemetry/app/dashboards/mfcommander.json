{
  "uid": "mfcommander-telemetry",
  "title": "MFCommander telemetry & licenses",
  "description": "Mirror of the MFCommander DynamoDB telemetry and license tables (postgres16/mfcommander), refreshed every 30 minutes by the mfcommander-telemetry-sync CronJob.",
  "tags": [
    "mfcommander",
    "telemetry",
    "licenses"
  ],
  "timezone": "utc",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Telemetry",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Minutes since last sync",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mfcommander"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mfcommander"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round(EXTRACT(EPOCH FROM now() - max(finished_at)) / 60) AS \"Minutes since last sync\"\nFROM sync_runs"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 45
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "description": "Age of the newest sync_runs row. The CronJob runs every 30 minutes; above 90 means the mirror is stale."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Rows read from DynamoDB (last sync)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mfcommander"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mfcommander"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT telemetry_reports AS \"Telemetry reports\",\n       telemetry_aggregates AS \"Aggregate rows\",\n       licenses AS \"Licenses\",\n       skipped_rows AS \"Skipped bookkeeping rows\"\nFROM sync_runs\nORDER BY finished_at DESC\nLIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "description": "Rows mirrored by the most recent run. Skipped rows are recover-throttle# bookkeeping entries in the licenses table."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Reporting installs (time range)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mfcommander"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mfcommander"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(DISTINCT install_id) AS \"Reporting installs\"\nFROM telemetry_reports\nWHERE $__timeFilter(day)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name",
        "wideLayout": true
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Reporting installs per day by tier",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mfcommander"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mfcommander"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT (day::timestamp AT TIME ZONE 'UTC') AS time,\n       coalesce(tier, 'unknown') AS metric,\n       count(DISTINCT install_id) AS value\nFROM telemetry_reports\nWHERE $__timeFilter(day)\nGROUP BY 1, 2\nORDER BY 1, 2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "barAlignment": 0
          },
          "unit": "short",
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Distinct installs that sent a report on each UTC day."
    },

          "rawQuery": true,
          "rawSql": "SELECT issued_at AS \"Issued\",\n       license_id AS \"License\",\n       email AS \"Email\",\n       customer_name AS \"Customer\",\n       tier AS \"Tier\",\n       status AS \"Status\",\n       updates_until AS \"Updates until\",\n       last_validated_at AS \"Last validated\",\n       revoked_at AS \"Revoked\",\n       polar_order_id AS \"Polar order\"\nFROM licenses\nORDER BY issued_at DESC NULLS LAST"

    {
      "id": 16,
      "type": "table",
      "title": "Recently validated licenses",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mfcommander"
      },
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mfcommander"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT last_validated_at AS \"Last validated\",\n       license_id AS \"License\",\n       tier AS \"Tier\",\n       status AS \"Status\",\n       customer_name AS \"Customer\"\nFROM licenses\nWHERE $__timeFilter(last_validated_at)\nORDER BY last_validated_at DESC\nLIMIT 100"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "description": "Licenses whose last validation falls in the time range, newest first."
    },
    {
      "id": 17,
      "type": "table",
      "title": "Licensed-install feature usage",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mfcommander"
      },
      "gridPos": {
        "x": 12,
        "y": 43,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mfcommander"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT l.tier AS \"License tier\",\n       c.key AS \"Counter\",\n       count(DISTINCT r.install_id) AS \"Licensed installs\",\n       count(DISTINCT l.license_id) AS \"Licenses\",\n       sum(c.value::numeric)::bigint AS \"Total reported uses\"\nFROM telemetry_reports r\nJOIN licenses l ON l.license_id = r.license_id\nCROSS JOIN LATERAL jsonb_each_text(r.counters) AS c(key, value)\nWHERE $__timeFilter(r.day)\n  AND c.value::numeric > 0\nGROUP BY 1, 2\nORDER BY 3 DESC, 1, 2"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "description": "Telemetry reports joined to licenses on license_id (schema v2 licensed installs only), counters above zero in the time range."
    },

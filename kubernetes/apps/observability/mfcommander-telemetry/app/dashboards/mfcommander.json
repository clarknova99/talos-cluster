    {
      "id": 9,
      "type": "table",
      "title": "Trial funnel (distinct installs per step)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mfcommander"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mfcommander"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT f.step AS \"Step\",\n       f.installs AS \"Installs\",\n       round(100.0 * f.installs / NULLIF(first_value(f.installs) OVER (ORDER BY f.ord), 0), 1) AS \"% of trial starts\"\nFROM (\n  SELECT s.ord, s.step, count(DISTINCT r.install_id) AS installs\n  FROM (VALUES (1, 'trial.started'), (2, 'paywall.hit'), (3, 'buy.clicked'), (4, 'license.activated')) AS s(ord, step)\n  LEFT JOIN telemetry_reports r\n    ON $__timeFilter(r.day)\n   AND (r.counters ->> s.step)::numeric > 0\n  GROUP BY s.ord, s.step\n) AS f\nORDER BY f.ord"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Installs"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "% of trial starts"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "max",
                "value": 100
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "description": "Distinct installs whose counter for each step was above zero in the time range. Steps are counted independently, not as a strict per-install sequence."
    },
    {
      "id": 10,
      "type": "table",
      "title": "Feature reach per counter (schema v1 + v2)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mfcommander"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mfcommander"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH reporting AS (\n  SELECT count(DISTINCT install_id) AS installs\n  FROM telemetry_reports\n  WHERE $__timeFilter(day)\n)\nSELECT c.key AS \"Counter\",\n       count(DISTINCT r.install_id) AS \"Installs using it\",\n       round(100.0 * count(DISTINCT r.install_id) / NULLIF((SELECT installs FROM reporting), 0), 1) AS \"% of reporting installs\"\nFROM telemetry_reports r\nCROSS JOIN LATERAL jsonb_each_text(r.counters) AS c(key, value)\nWHERE $__timeFilter(r.day)\n  AND c.value::numeric > 0\nGROUP BY c.key\nORDER BY 2 DESC, 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "% of reporting installs"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "max",
                "value": 100
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "description": "Distinct installs whose counter was above zero in the time range. Valid for both schema versions: a v1 range ordinal of 0 and a v2 count of 0 both mean unused."
    },
    {
      "id": 11,
      "type": "table",
      "title": "Usage volume per counter (schema v2 exact counts only)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mfcommander"
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mfcommander"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT c.key AS \"Counter\",\n       sum(c.value::numeric)::bigint AS \"Total reported uses\",\n       count(DISTINCT r.install_id) FILTER (WHERE c.value::numeric > 0) AS \"v2 installs using it\",\n       round(avg(c.value::numeric) FILTER (WHERE c.value::numeric > 0), 1) AS \"Mean per non-zero report\"\nFROM telemetry_reports r\nCROSS JOIN LATERAL jsonb_each_text(r.counters) AS c(key, value)\nWHERE r.schema_version = 2\n  AND $__timeFilter(r.day)\nGROUP BY c.key\nORDER BY 2 DESC, 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Total reported uses"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "description": "Sums exact counts from schema_version 2 reports only. Schema v1 reports carry range ordinals (0..5) that cannot be summed and are excluded."
    },
    {
      "id": 12,

#!/usr/bin/env bash
# Operator CLI for the senseichess.com AWS DR (see dr/RUNBOOK.md).
# Requires: aws (profile with access to the sensei account), jq.
set -euo pipefail

export AWS_PROFILE="${AWS_PROFILE:-mike-sensei}"
export AWS_REGION="${AWS_REGION:-us-east-1}"
FN=sensei-dr-orchestrator
ASG=sensei-dr

usage() {
  cat <<'EOF'
usage: drctl <command>

  status [--dns]                 state, heartbeat, instance progress (+ current DNS targets)
  arm | disarm                   enable / disable automatic failover
  drill start [--branch B]       start a drill (optionally syncing git branch B)
  drill stop                     stop the drill and terminate the instance
  failover [reason]              manual failover (promotes a running drill in place)
  abort                          abort FAILOVER/DRILL before the DNS switch
  failback stop-home-apps        stop other home apps using postgres16vector (site stays on AWS)
  failback rebuild-home          recreate home postgres16vector as a replica of the DR archive
  failback lag                   how far the home replica trails AWS
  failback freeze                DR -> maintenance: stop sensei-prod, final Postgres backup
  failback unfreeze              undo freeze (serve from DR again)
  failback promote               promote the caught-up home replica (after freeze)
  failback dns                   point DNS back home (state FAILBACK)
  failback complete              state STANDBY, approve home unfence, terminate instance
  failback start-home-apps       restart the apps stopped by stop-home-apps
  branch [name]                  show / set the git branch the DR cluster syncs
  exec '<shell command>'         run a command on the DR instance via SSM (as root)
  logs                           bootstrap + agent journal from the DR instance
  shell                          SSM session on the DR instance (needs session-manager-plugin)
  kubeconfig [file]              save the DR k3s kubeconfig (default ~/.kube/sensei-dr.yaml)
  tunnel [local-port]            forward localhost:<port> (default 6443) to the k3s API via SSM
EOF
}

invoke() {
  local out
  out="$(mktemp)"
  aws lambda invoke --function-name "$FN" --cli-binary-format raw-in-base64-out \
    --payload "$1" "$out" --query FunctionError --output text >"$out.err"
  if [ "$(cat "$out.err")" != "None" ]; then
    jq -r '.errorMessage // .' "$out" >&2
    rm -f "$out" "$out.err"
    exit 1
  fi
  cat "$out"
  rm -f "$out" "$out.err"
}

request() { invoke "$(jq -nc --arg r "$1" --arg why "${2:-}" '{request:$r, reason:$why}')" | jq .; }

instance_id() {
  aws autoscaling describe-auto-scaling-groups --auto-scaling-group-names "$ASG" \
    --query 'AutoScalingGroups[0].Instances[?LifecycleState==`InService`].InstanceId | [0]' --output text
}

remote() {
  local id cmd_id status
  id="$(instance_id)"
  [ "$id" != "None" ] || { echo "no DR instance running" >&2; exit 1; }
  cmd_id="$(aws ssm send-command --instance-ids "$id" --document-name AWS-RunShellScript \
    --parameters "$(jq -nc --arg c "export KUBECONFIG=/etc/rancher/k3s/k3s.yaml PATH=/usr/local/bin:\$PATH; $1" '{commands:[$c]}')" \
    --query Command.CommandId --output text)"
  for _ in $(seq 1 60); do
    sleep 2
    status="$(aws ssm get-command-invocation --command-id "$cmd_id" --instance-id "$id" --query Status --output text 2>/dev/null || true)"
    case "$status" in Success|Failed|Cancelled|TimedOut) break ;; esac
  done
  aws ssm get-command-invocation --command-id "$cmd_id" --instance-id "$id" \
    --query '[StandardOutputContent,StandardErrorContent]' --output text
}

status() {
  local payload='{"status":true}'
  [ "${1:-}" = "--dns" ] && payload='{"status":true,"dns":true}'
  invoke "$payload" | jq -r --argjson now "$(date +%s)" '
    def age(t): if t == null then "never" else "\(($now - t) | floor)s ago" end;
    "state:      \(.dr.state // "STANDBY")  (armed=\(.dr.armed // false), autoArm=\(.dr.autoArm // true))",
    "mode:       desired=\(.dr.desiredMode // "-")  run=\(.dr.runId // "-")",
    "heartbeat:  \(age(.home.lastHeartbeat))  home.fenced=\(.home.fenced // false) unfenceApproved=\(.home.unfenceApproved // false)",
    "probe:      failures=\(.dr.probeFailures // 0)  last=\(.dr.lastProbe // "-" | tostring)",
    "instance:   phase=\(.instance.phase // "-") ready=\(.instance.ready // false) mode=\(.instance.appliedMode // "-") updated \(age(.instance.updatedAt))",
    "            \(.instance.message // "")",
    "postgres:   source=\(.instance.sourceServer // "-") -> serverName=\(.instance.serverName // "-")  lastBackup=\(.instance.lastBackup // "-")",
    "clickhouse: \(.instance.clickhouseRestore // "-")",
    (if .dns then "dns:", (.dns | to_entries[] | "  \(.key) -> \(.value)") else empty end),
    "history:", (.dr.history // [] | .[-5:][] | "  \(.at | todate) \(.from) -> \(.to): \(.reason)")'
}

cmd="${1:-}"; shift || true
case "$cmd" in
  status) status "$@" ;;
  _status-json) invoke '{"status":true}' ;;
  arm|disarm|abort) request "$cmd" ;;
  failover) request failover "${1:-manual}" ;;
  drill)
    case "${1:-}" in
      start)
        if [ "${2:-}" = "--branch" ]; then
          aws ssm put-parameter --name /sensei-dr/git-branch --value "$3" --overwrite >/dev/null
          echo "DR git branch: $3"
        fi
        request drill-start ;;
      stop) request drill-stop ;;
      *) usage; exit 2 ;;
    esac ;;
  failback)
    case "${1:-}" in
      freeze|unfreeze) request "$1" ;;
      dns) request failback-dns ;;
      complete) request complete ;;
      stop-home-apps|start-home-apps|rebuild-home|lag|promote)
        exec "$(dirname "$0")/failback-home.sh" "$1" ;;
      *) usage; exit 2 ;;
    esac ;;
  branch)
    if [ -n "${1:-}" ]; then
      aws ssm put-parameter --name /sensei-dr/git-branch --value "$1" --overwrite >/dev/null
      echo "note: a running DR instance keeps its branch until: drctl exec 'kubectl -n flux-system patch gitrepository flux-system --type merge -p \"{\\\"spec\\\":{\\\"ref\\\":{\\\"branch\\\":\\\"$1\\\"}}}\"'"
    fi
    aws ssm get-parameter --name /sensei-dr/git-branch --query Parameter.Value --output text ;;
  exec) remote "$*" ;;
  logs) remote "journalctl -u sensei-dr-bootstrap -u sensei-dr-agent --no-pager -n ${1:-80}" ;;
  shell) aws ssm start-session --target "$(instance_id)" ;;
  kubeconfig)
    # Admin credentials of the current DR instance (a new instance has a new CA: fetch again).
    file="${1:-$HOME/.kube/sensei-dr.yaml}"
    port="${2:-6443}"
    mkdir -p "$(dirname "$file")"
    (umask 077
     remote 'cat /etc/rancher/k3s/k3s.yaml' | sed -e $'s/\t.*$//' | sed -n '/^apiVersion:/,$p' \
       | sed -e "s#https://127.0.0.1:6443#https://127.0.0.1:${port}#" -e 's/: default$/: sensei-dr/' >"$file")
    grep -q 'client-key-data' "$file" || { echo "could not read the kubeconfig (is the instance bootstrapped?)" >&2; exit 1; }
    echo "wrote $file (context sensei-dr). In another terminal: dr/bin/drctl tunnel $port"
    echo "then: KUBECONFIG=$file kubectl get nodes" ;;
  tunnel)
    command -v session-manager-plugin >/dev/null || { echo "install it first: brew install --cask session-manager-plugin" >&2; exit 1; }
    aws ssm start-session --target "$(instance_id)" --document-name AWS-StartPortForwardingSession \
      --parameters "{\"portNumber\":[\"6443\"],\"localPortNumber\":[\"${1:-6443}\"]}" ;;
  ""|-h|--help|help) usage ;;
  *) usage; exit 2 ;;
esac
